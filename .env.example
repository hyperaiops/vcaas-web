# SQLite database path for workspace metadata.
WORKSPACE_DB_PATH=.data/workspaces.db

# Directory where workspace files are scaffolded on disk (one subdir per workspace).
WORKSPACE_FILES_ROOT=.data/workspaces

# On-disk cache for generated binary snapshots, keyed by content revision.
SNAPSHOT_DIRECTORY=.data/.snapshots

# Scaffold source for new workspaces (copied into WORKSPACE_FILES_ROOT/{id}).
TEMPLATE_DIR=./template

# --- Authing OIDC (server-only; never use NEXT_PUBLIC_ for secrets) ---
AUTH_ORIGIN=https://console.vibe-coding.host
AUTH_ISSUER=https://vibe-coding-host.authing.cn/oidc
AUTH_CLIENT_ID=6aae0a13969a9131274d7e08
AUTH_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
AUTH_SESSION_KEY=
# Callback: https://console.vibe-coding.host/auth/callback
# Logout callback: https://console.vibe-coding.host/
# Login initiation: https://console.vibe-coding.host/auth/login

# --- PI agent (per-workspace PiWorker CR, production) ---
# Opening a workspace creates a `PiWorker` custom resource (ubi.pi.dev/v1alpha1);
# the PiWorker operator reconciles it into a Deployment + Service + Ingress +
# auto-generated bearer-token Secret and exposes a public `ws(s)://.../v1/rpc`
# endpoint in .status.endpoint. Leaving the workspace deletes the CR; the
# operator garbage-collects the child resources. The Next.js server manages the
# CR over the Kubernetes API (in-cluster service account, or ~/.kube/config /
# $KUBECONFIG when running outside the cluster).
#
# Prerequisites (not set here): the PiWorker operator must be installed
# (`make install && make deploy` in the PiWorker repo, with --worker-image /
# --ingress-domain / TLS configured). The LiteLLM API key is passed inline in
# `spec.litellm.apiKey`; the operator projects it into the agent Pod via a
# controller-owned Secret (pw-<id>-litellm, key `api-key`) that is garbage-
# collected with the CR — Next.js does not create or manage that Secret.
#
# Workspace files: when the operator manager is started with --nfs-server
# and --nfs-share, each worker Pod mounts <nfs-share>/<PiWorker.name> at
# /workspace. The CR is named after the workspace id, so the directory Next.js
# scaffolds at WORKSPACE_FILES_ROOT/<id> must be the same tree the operator
# mounts — i.e. WORKSPACE_FILES_ROOT must be the NFS share (--nfs-share) or a
# path equivalent to it (same server export).

# Namespace where PiWorker CRs (one per workspace, named after the workspace id)
# live. The Next.js pod's ServiceAccount needs RBAC to get/create/delete
# piworkers and get secrets there.
PI_NAMESPACE=agents

# LiteLLM (OpenAI-compatible) endpoint + model the agent routes traffic through.
PI_LITELLM_BASE_URL=https://llm.ubichat.ubisoft.org
PI_LITELLM_MODEL=glm-5.2
# LiteLLM API key, written into each workspace's per-CR Secret (key `api-key`).
# This is the per-user key; it varies per workspace going forward.
PI_LITELLM_API_KEY=

# Ingress config written into each PiWorker spec; must align with the
# operator manager's --ingress-domain / wildcard TLS.
# PI_INGRESS_CLASS=nginx
# PI_INGRESS_TLS_SECRET=wildcard-agents-tls

# Browser origin the bridge allows for WebSocket connections (its Origin
# check); set to the Web IDE's public origin.
# PI_BRIDGE_ALLOWED_ORIGIN=https://ide.example.com

# --- Outside-the-cluster dev access to the agent Ingress ---
# Only set these when running Next.js OUTSIDE the cluster, with the ingress
# controller port-forwarded to localhost (kubectl -n ingress-nginx port-forward
# svc/ingress-nginx-controller 8443:443). The server then connects to the agent
# by splitting TCP target (127.0.0.1:8443) from TLS SNI (the agent's real host).
# Leave unset when running in-cluster — the server connects to the wss://
# endpoint directly with normal DNS + TLS.
# PI_INGRESS_FORWARD_HOST=127.0.0.1
# PI_INGRESS_FORWARD_PORT=8443
